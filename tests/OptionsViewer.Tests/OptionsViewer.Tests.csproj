<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- CSV de referencia: se enlazan desde samples/ y se copian a la salida; no se duplican en tests/ -->
  <ItemGroup>
    <None Include="..\..\samples\*.csv" Link="samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OptionsViewer.Core\OptionsViewer.Core.csproj" />
    <ProjectReference Include="..\..\src\OptionsViewer.Infrastructure\OptionsViewer.Infrastructure.csproj" />
  </ItemGroup>

</Project>
